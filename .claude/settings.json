{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx ng:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm game:dev:*)",
      "Bash(pnpm tokens:*)",
      "Bash(pnpm --filter site build:*)",
      "Bash(pnpm --filter site test:*)",
      "Bash(pnpm --filter @site/dither test:*)",
      "Bash(pnpm --filter @site/game test:*)",
      "Bash(npx playwright:*)",
      "Bash(ng:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(.claude/skills/impeccable/scripts/impeccable:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
