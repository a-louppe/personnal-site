{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm --filter site start",
    "build": "pnpm --filter site build && node scripts/postbuild.mjs",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "pnpm build && playwright test",
    "game:dev": "pnpm --filter @site/game dev",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p apps/site/tsconfig.app.json && tsc --noEmit -p apps/site/tsconfig.spec.json && tsc --noEmit -p packages/dither/tsconfig.json && tsc --noEmit -p packages/game/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "size": "node scripts/check-bundle-size.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "lhci": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.10",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
