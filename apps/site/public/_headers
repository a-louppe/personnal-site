# Cloudflare static assets headers (also valid on Pages). Copied to the build output.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

# Hashed build output never changes under the same name. Rules that match merge their headers
# (same header = comma-joined), so `! Cache-Control` first removes the inherited no-cache.
/*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Keep previews and the default workers.dev / pages.dev domains out of search results.
https://:project.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:branch.:project.pages.dev/*
  X-Robots-Tag: noindex
